{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["packages/**/*.ts", "adapters/**/*.ts", "apps/**/*.ts", "tests/**/*.ts", "features/**/*.ts", "scripts/**/*.ts"]
}
